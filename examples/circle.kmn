push 0
pop CX ; counter = 0

push 0
pop AX ; x = 0

push 0
pop BX ; y = 0

.loop:
    push CX
    push 1600
    je .end

    ; (x - 12)^2 + (y - 12)^2 = 144
    push AX
    push 20
    sub
    pop AX

    push AX
    push AX
    mul

    push BX
    push 20
    sub
    pop BX

    push BX
    push BX
    mul

    add
    push 100
    jbe .fill_pixel
.empty_pixel:
    push 0
    set CX

    jmp .go_again
.fill_pixel:
    push 1
    set CX

.go_again:
    push CX
    push 1
    add
    pop CX

    push CX
    push 40 ; row_size
    div  
    pop BX ; y = CX / 15

    push CX
    
    push BX
    push 40
    mul

    sub
    pop AX ; x = CX - 15 * y

    jmp .loop


.end:
    disp
    ; disprst
    hlt